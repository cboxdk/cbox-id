{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cboxdk/laravel-id-compliance",
    "description": "Cbox ID compliance plugin (commercial) \u2014 streams the platform's append-only, hash-chained audit trail to a pluggable export sink (JSONL bundles or a SIEM endpoint behind a contract, inert by default), verifies the chain, and lights up a Compliance console with honest append-only retention and a data-subject export. Data + UI in one drop-in package.",
    "keywords": [
        "cbox",
        "identity",
        "compliance",
        "audit",
        "siem",
        "gdpr",
        "plugin",
        "laravel"
    ],
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "cboxdk/laravel-id": ">=0.19 <1.0",
        "cboxdk/laravel-console-kit": "^0.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "livewire/volt": "^1.6.0 || ^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.5 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Cbox\\Id\\Compliance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbox\\Id\\Compliance\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "pest",
        "license-check": "@php bin/check-licenses.php",
        "sbom": "@php bin/generate-sbom.php",
        "qa": [
            "@lint",
            "@analyse",
            "@test",
            "@license-check",
            "@composer audit --no-dev"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbox\\Id\\Compliance\\ComplianceServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
