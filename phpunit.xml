<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <!-- `docs-screenshots` rewrites docs/screenshots/*.png from the running app
         (tests/Browser/DocsScreenshotsTest.php). It writes into the working tree, so a plain
         `vendor/bin/pest` leaves it out; asking for the group by name (the `group` option,
         as that file's docblock shows, and as .github/workflows/docs-screenshots.yml does on
         every release tag) runs it, because a group asked for by name is taken back off
         this list. A command line that passes its own `exclude-group` replaces this list,
         so it must name this group too. -->
    <groups>
        <exclude>
            <group>docs-screenshots</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
            <directory>modules</directory>
        </include>
    </source>
    <php>
        <!-- The suite boots the whole platform (Testbench + Pest 4 browser tests) and
             does not fit in a stock 128M. Setting it here means the plain, documented
             `vendor/bin/pest` works on any machine, instead of only where php.ini
             happens to be generous or the caller remembered `-d memory_limit`. 2G, not 1G:
             CI runs the whole suite in ONE process and what it holds grows from test to
             test; the console crawls tipped 1G there once the suite passed ~5,600 tests,
             although a crawl alone needs ~256M. Bring this back down with the leak fixed. -->
        <ini name="memory_limit" value="2G"/>
        <!-- The suite-owned infrastructure (APP_ENV, CACHE_STORE, QUEUE_CONNECTION,
             SESSION_DRIVER, …) is set in tests/bootstrap.php instead of here: `<env>`
             writes $_ENV and putenv() but not $_SERVER, which is the first place
             Laravel's Env repository looks, so a CI runner exporting
             QUEUE_CONNECTION=redis silently won. See that file for the full account.

             What stays here is DB_*, and only DB_*: the engines matrix deliberately
             overrides it from the process environment to redirect the run at PostgreSQL
             or MySQL, so it is the one thing the suite must NOT pin. -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
    </php>
</phpunit>
