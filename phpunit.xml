<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>modules</directory>
        </include>
    </source>
    <php>
        <!-- The suite boots the whole platform (Testbench + Pest 4 browser tests) and
             does not fit in a stock 128M. Setting it here means the plain, documented
             `vendor/bin/pest` works on any machine, instead of only where php.ini
             happens to be generous or the caller remembered `-d memory_limit=1G`. -->
        <ini name="memory_limit" value="1G"/>
        <!-- The suite-owned infrastructure (APP_ENV, CACHE_STORE, QUEUE_CONNECTION,
             SESSION_DRIVER, …) is set in tests/bootstrap.php instead of here: `<env>`
             writes $_ENV and putenv() but not $_SERVER, which is the first place
             Laravel's Env repository looks, so a CI runner exporting
             QUEUE_CONNECTION=redis silently won. See that file for the full account.

             What stays here is app configuration no host is expected to export, and
             DB_*, which the engines matrix deliberately overrides from the process
             environment to redirect the run at PostgreSQL or MySQL. -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="CBOX_ID_CRYPTO_KEY" value="YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE="/>
        <env name="CBOX_ID_ISSUER" value="http://localhost"/>
        <env name="CBOX_ID_WEBAUTHN_RP_ID" value="localhost"/>
        <env name="CBOX_ID_WEBAUTHN_ORIGIN" value="http://localhost"/>
    </php>
</phpunit>
