includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max

    paths:
        - app
        - config
        - database
        - modules
        - routes
        # `resources/views/livewire` used to be listed here: Volt single-file
        # components were real PHP (a `<?php` block in a `.blade.php` file, which
        # PHPStan reads because the extension IS `php`), and 90+ of them held the
        # console's logic. Every one of them is a controller now, under `app`,
        # which this already analyses — so the path is gone with the directory.

    # No baseline and no ignoreErrors on purpose: real findings should surface
    # and be fixed, not papered over.
