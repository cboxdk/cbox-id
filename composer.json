{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cboxdk/cbox-id",
    "type": "project",
    "description": "Cbox ID \u2014 the hosted, self-hostable identity platform app (admin console + hosted cloud) built on cboxdk/laravel-id.",
    "keywords": [
        "cbox",
        "identity",
        "sso",
        "scim",
        "oidc"
    ],
    "license": "Elastic-2.0",
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.1",
        "cboxdk/dns": "^0.1",
        "cboxdk/laravel-console-kit": "^0.2",
        "cboxdk/laravel-dns": "^0.1.0",
        "cboxdk/laravel-health": "^2.0",
        "cboxdk/laravel-id": "^1.14",
        "cboxdk/laravel-postal": "^0.1.1",
        "cboxdk/laravel-queue-autoscale": "^3.0",
        "cboxdk/laravel-queue-metrics": "^3.2",
        "cboxdk/laravel-risk": "^1.1",
        "cboxdk/laravel-ssrf": "^1.1.1",
        "cboxdk/laravel-telemetry": "^1.0",
        "firebase/php-jwt": "^7.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.3",
        "livewire/volt": "^1.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "opis/json-schema": "^2.4",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-browser": "^4.3",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Cbox\\Id\\Analytics\\": "modules/analytics/src/",
            "Cbox\\Id\\Billing\\": "modules/billing/src/",
            "Cbox\\Id\\Compliance\\": "modules/compliance/src/",
            "Cbox\\Id\\Connectors\\": "modules/connectors/src/",
            "Cbox\\Id\\Devices\\": "modules/devices/src/",
            "Cbox\\Id\\RiskPlus\\": "modules/risk-plus/src/",
            "Cbox\\Id\\Whitelabel\\": "modules/whitelabel/src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan key:generate",
            "@php artisan cbox-id:install",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php -d memory_limit=1G artisan test"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse --no-progress --memory-limit=2G"
        ],
        "license-check": "@php bin/check-licenses.php",
        "sbom": "@php bin/generate-sbom.php",
        "sbom-check": "@php bin/generate-sbom.php --check",
        "qa": [
            "@php vendor/bin/pint --test",
            "@analyse",
            "@test",
            "@license-check",
            "@sbom-check",
            "@composer audit --no-dev"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "process-timeout": 0,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
