# Generated by laravel/wayfinder from routes/*.php on every dev start and every build
# (see vite.config.ts). Committing them would mean a second source of truth for what the
# routes are, and a diff nobody reads.
/resources/js/actions
/resources/js/routes
/resources/js/wayfinder


# Pest writes the page it was looking at here when a browser test fails. The BASELINES it
# compares against live in `tests/.pest/snapshots` and ARE committed — a visual regression
# test with no committed baseline is a test that passes on every machine for the first
# time, forever.
/tests/Browser/Screenshots
