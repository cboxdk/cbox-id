{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "php artisan wayfinder:generate --with-form && tsc --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "prettier --write resources/js resources/css",
        "format:check": "prettier --check resources/js resources/css",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@inertiajs/react": "^3.7.0",
        "@tanstack/react-table": "^9.1.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "lucide-react": "^1.34.0",
        "radix-ui": "^1.6.7",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.6",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^4.1.11",
        "axe-core": "^4.12.1",
        "concurrently": "^9.0.1",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^2.1.0",
        "oxlint": "^1.80.0",
        "playwright": "^1.61.1",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "vite": "^7.0.7",
        "vitest": "^4.1.11"
    }
}
